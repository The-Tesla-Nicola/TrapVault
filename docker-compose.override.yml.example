# Docker Compose Override
# Copy to docker-compose.override.yml and customize for local development

services:
  backend:
    environment:
      DEBUG: 'True'
    volumes:
      - ./backend:/app
    command: python manage.py runserver 0.0.0.0:8000

  nginx:
    ports:
      - "80:80"
      - "443:443"

  prometheus:
    ports:
      - "9090:9090"

  grafana:
    ports:
      - "3001:3000"
