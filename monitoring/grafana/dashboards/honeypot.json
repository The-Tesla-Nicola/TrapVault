{
  "title": "Honeypot SIEM — Security Intelligence",
  "uid": "honeypot-main",
  "schemaVersion": 36,
  "version": 2,
  "refresh": "10s",
  "timezone": "browser",
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Total Attack Events",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "honeypot_total_events", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 1000}]}}}
    },
    {
      "id": 2, "type": "stat", "title": "Blocked Attackers",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "honeypot_blocked_sessions", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "orange", "value": 10}]}}}
    },
    {
      "id": 3, "type": "stat", "title": "Captured Credentials",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "honeypot_captured_creds", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}}}
    },
    {
      "id": 4, "type": "gauge", "title": "Avg Latency (Honeypot)",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "honeypot_response_time_ms_avg", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ms", "min": 0, "max": 3000, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1000}, {"color": "red", "value": 2500}]}}}
    },
    {
      "id": 5, "type": "timeseries", "title": "Attack Velocity (Rate per Minute)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [{"expr": "sum(rate(honeypot_total_events[1m])) * 60", "legendFormat": "Events/min", "refId": "A"}],
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "id": 6, "type": "piechart", "title": "Attack Category Breakdown",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 4},
      "targets": [{"expr": "sum by (type) (honeypot_events_by_type)", "legendFormat": "{{type}}", "refId": "A"}],
      "options": {"legend": {"displayMode": "list", "placement": "right"}, "pieType": "donut"}
    },
    {
      "id": 7, "type": "piechart", "title": "Severity Distribution",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 4},
      "targets": [{"expr": "sum by (severity) (honeypot_events_by_severity)", "legendFormat": "{{severity}}", "refId": "A"}],
      "options": {"legend": {"displayMode": "list", "placement": "right"}},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "blue", "value": null}, {"color": "yellow", "value": 50}, {"color": "red", "value": 90}]}}}
    },
    {
      "id": 8, "type": "timeseries", "title": "Login Funnel Trends",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [
        {"expr": "sum(rate(honeypot_login_outcomes{outcome=\"routed_real\"}[5m]))", "legendFormat": "Allow (Legit)", "refId": "A"},
        {"expr": "sum(rate(honeypot_login_outcomes{outcome=\"routed_honeypot\"}[5m]))", "legendFormat": "Deceive (Honeypot)", "refId": "B"},
        {"expr": "sum(rate(honeypot_login_outcomes{outcome=\"blocked\"}[5m]))", "legendFormat": "Block (High Risk)", "refId": "C"}
      ],
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "id": 9, "type": "bargauge", "title": "Top Attack Types (Cumulative)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [{"expr": "sort_desc(sum by (type) (honeypot_events_by_type))", "legendFormat": "{{type}}", "refId": "A"}],
      "options": {"displayMode": "gradient", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"]}}
    }
  ],
  "templating": {"list": []},
  "annotations": {"list": []}
}
