# TrapVault — Environment Configuration
# Copy to .env and fill all values before starting. NEVER commit .env.

# Django Core
SECRET_KEY=change-this-to-a-random-string-of-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=*

# Database
POSTGRES_DB=honeypot
POSTGRES_USER=honeypot
POSTGRES_PASSWORD=change-this-postgres-password-use-something-strong

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=change-this-redis-password

# JWT Secrets
MONITOR_JWT_SECRET=change-this-monitor-jwt-secret-long-random-string
REAL_BANK_JWT_SECRET=change-this-real-bank-jwt-secret-long-random-string

# SIEM Engine Thresholds
SIEM_DECEIVE_THRESHOLD=45
SIEM_BLOCK_THRESHOLD=120
SIEM_BURST_LIMIT=20
SIEM_BRUTE_LIMIT=8

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# GeoIP (optional — download GeoLite2-City.mmdb from MaxMind)
GEOIP_PATH=/app/geoip/GeoLite2-City.mmdb

# Legitimate Test Users (optional)
# Comma-separated usernames that bypass SIEM scoring (for testing)
LEGITIMATE_BYPASS_USERS=

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-this-grafana-password

# Alert Notifications (optional)
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=siem@yourdomain.com
ALERT_EMAIL_TO=security@yourdomain.com

# Threat Intel API Keys (optional)
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
GREYNOISE_API_KEY=
