# ═══════════════════════════════════════════════════════════════════════
# ENTERPRISE HONEYPOT + SIEM — ENVIRONMENT CONFIGURATION
# Copy to .env and fill all values before starting. NEVER commit .env.
# ═══════════════════════════════════════════════════════════════════════

# ── Django Core ─────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(50))"
SECRET_KEY=change-this-to-a-random-string-of-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=*

# ── Database ─────────────────────────────────────────────────────────────
POSTGRES_DB=honeypot
POSTGRES_USER=honeypot
POSTGRES_PASSWORD=change-this-postgres-password-use-something-strong

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PASSWORD=change-this-redis-password

# ── JWT Secrets ───────────────────────────────────────────────────────────
# SIEM operator dashboard tokens (admin/analyst/viewer login)
MONITOR_JWT_SECRET=change-this-monitor-jwt-secret-long-random-string

# Real bank customer tokens (issued to legitimate users after ALLOW routing)
REAL_BANK_JWT_SECRET=change-this-real-bank-jwt-secret-long-random-string

# ── SIEM Engine Thresholds ───────────────────────────────────────────────
# Session risk score >= DECEIVE → routed to honeypot
SIEM_DECEIVE_THRESHOLD=45
# Session risk score >= BLOCK → HTTP 429 + blacklisted
SIEM_BLOCK_THRESHOLD=120
# Requests per minute before burst detection fires
SIEM_BURST_LIMIT=20
# Failed logins per 10 min before brute force flag raised
SIEM_BRUTE_LIMIT=8

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (production: set specific domains)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── GeoIP (optional — download GeoLite2-City.mmdb from MaxMind) ──────────
GEOIP_PATH=/app/geoip/GeoLite2-City.mmdb

# ── Legitimate Test Users (optional) ─────────────────────────────────────
# Comma-separated usernames that bypass SIEM scoring (for testing)
# Remove or set to empty in production to disable bypass
LEGITIMATE_BYPASS_USERS=michael.scott,dwight.schrute

# ── Grafana ───────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-this-grafana-password

# ── Alert Notifications (optional) ───────────────────────────────────────
# Slack incoming webhook URL
SLACK_WEBHOOK_URL=
# SMTP for email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=siem@yourdomain.com
ALERT_EMAIL_TO=security@yourdomain.com

# ── Threat Intel API Keys (optional) ──────────────────────────────────────
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
GREYNOISE_API_KEY=
