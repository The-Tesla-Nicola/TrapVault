# Fail2Ban jail configuration for Honeypot
# Copy to /etc/fail2ban/jail.local on the server

[DEFAULT]
bantime = 86400
findtime = 3600
maxretry = 5

[nginx-http-auth]
enabled = false

[sshd]
enabled = true
port = ssh
filter = sshd
logpath = /var/log/auth.log
maxretry = 3

[honeypot-siem]
enabled = true
port = http,https
filter = honeypot
logpath = /var/log/nginx/access.log
maxretry = 10
findtime = 600
bantime = 3600
action = iptables-allports

# Custom filter for honeypot attack detection